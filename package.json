{
  "name": "campaign-autopilot",
  "version": "0.1.0",
  "private": true,
  "description": "Campaign Autopilot: closed-loop evaluation and improvement of graph8 outbound campaigns (graph8 Programmable Revenue Hackathon, Lahore 2026)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "autopilot": "./bin/autopilot.js"
  },
