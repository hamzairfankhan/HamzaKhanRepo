# graph8 Developer API key for the HACKATHON DEMO WORKSPACE.
# Create it in the hackathon account: app.graph8.com -> Settings -> MCP & API -> API.
G8_API_KEY=

# Anthropic API key (console.anthropic.com). Needed only for the `analyze` step.
ANTHROPIC_API_KEY=

# manual  = every proposal waits for a human
# tiered  = write-tier, high-confidence proposals auto-apply; external/destructive always wait
AUTOPILOT_MODE=manual

# Optional overrides
# AUTOPILOT_MODEL=claude-opus-5
# AUTOPILOT_MIN_DELIVERED=100
